{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Logic Loop",
  "version": "0.1.0",
  "identifier": "com.vandershark.context-terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Logic Loop",
        "width": 1200,
        "height": 800,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dsh-terminal-app/package.json": "dsh-terminal-app/package.json",
      "../dsh-terminal-app/cordis.patch.yml": "dsh-terminal-app/cordis.patch.yml",
      "../dsh-terminal-app/LICENSE": "dsh-terminal-app/LICENSE",
      "../dsh-terminal-app/README.md": "dsh-terminal-app/README.md",
      "../dsh-terminal-app/src/index.js": "dsh-terminal-app/src/index.js",
      "../dsh-terminal-app/src/messages.js": "dsh-terminal-app/src/messages.js",
      "../dsh-terminal-app/src/format.js": "dsh-terminal-app/src/format.js",
      "../dsh-terminal-app/src/startup.js": "dsh-terminal-app/src/startup.js"
    }
  }
}

{
  "name": "dsh-terminal-app",
  "description": "A first-party interactive terminal chat runner for DeepSeek Harness (dsh), patched over the shipped headless bundle's dsh-base layer instead of the browser (dsh-web-app) layer.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "logicLoopAdapterVersion": 4,
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./startup": "./src/startup.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "@deepseek-ai/dsh-cmdline": "0.1.5-rc.2",
    "@deepseek-ai/dsh-util-values": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2"
  }
}
